# Server
PORT=5000
NODE_ENV=production

# CORS (comma-separated)
ALLOWED_ORIGINS=https://athravambalge-boop.github.io

# Frontend + backend public URLs
APP_BASE_URL=https://athravambalge-boop.github.io/FSDProject/frontend
BACKEND_BASE_URL=https://your-backend.onrender.com

# Database
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=messmate_db
DB_CONNECTION_LIMIT=10

# Payments
PAYMENT_PROVIDER=phonepe
PAYMENT_CURRENCY=INR
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key
PHONEPE_SALT_INDEX=1

# Optional Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
